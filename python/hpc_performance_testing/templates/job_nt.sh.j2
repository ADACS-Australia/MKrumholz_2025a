#!{{ shell }}
#SBATCH --job-name={{ name }}_n{{ core }}
#SBATCH --ntasks-per-node={{ ntasks_per_node }}
#SBATCH --nodes={{ node }}
#SBATCH --output={{ result_dir }}/{{ name }}_n{{ core }}_JobID_%j.out
#SBATCH --time={{ walltime }}
#SBATCH --mem={{ mem_per_node }}

# 1 task  1 GPU core
#SBATCH --gpus-per-task=1
#SBATCH --gpu-bind=closest

{% if partition %}
#SBATCH --partition={{ partition }}
{% endif %}

# Setup and activate environment
source {{environment}}

# Run step
cd {{ result_dir }}
srun {{ target }} {{ input_file }} {{ ncell_args }}

